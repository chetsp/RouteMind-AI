# Copy to .env for docker compose, or export selected values before local startup.
# Optional: with neither model nor API key set, the limited demo parser is used.
# Gemini (Google AI Studio): uncomment these three lines and add your key locally.
# ROUTEMIND_PROVIDER=gemini
# ROUTEMIND_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=enter-securely-outside-source-control
# OpenAI alternative (choose one provider/model combination):
# ROUTEMIND_PROVIDER=openai
# ROUTEMIND_MODEL=gpt-4.1-mini
# ROUTEMIND_API_KEY=enter-securely-outside-source-control
# DATABASE_URL=postgresql+psycopg://routemind:local-demo-only@127.0.0.1:5432/routemind
# DATA_DIR=.data
# CORS_ORIGINS=https://your-frontend.example
# Default auto uses MiniLM (preloaded in Docker), with explicit hash fallback.
# EMBEDDING_BACKEND=auto
# Strict learned semantic search (fail if unavailable):
# EMBEDDING_BACKEND=minilm
# Native startup downloads the verified model once; Docker caches it at build.
# EMBEDDING_BACKEND=hash  # Fully offline baseline, no learned semantics.
# Alternatively: pip install '.[semantic]'; all three fields required below.
# EMBEDDING_BACKEND=sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_REVISION=<reviewed-exact-model-commit>
